<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaPlayer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#111318"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OpenFiles_Click" Content="Open media" />
            <Button Grid.Column="1" Click="OpenPlaylist_Click" Content="Open playlist" />
            <ToggleButton x:Name="RandomButton" Grid.Column="2" Content="Random order" />
            <TextBlock x:Name="TitleText" Grid.Column="3" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Open media or a playlist to begin" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CountText" Grid.Column="4" VerticalAlignment="Center" Foreground="#AAB2C0" />
        </Grid>

        <Border Grid.Row="1" Background="#08090C" CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" ZoomMode="Disabled">
                <Grid x:Name="MediaSurface" MinWidth="400" MinHeight="300" HorizontalAlignment="Center" VerticalAlignment="Center" PointerWheelChanged="MediaSurface_PointerWheelChanged">
                    <Grid.RenderTransform><ScaleTransform x:Name="MediaScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                    <Image x:Name="ImageView" MaxWidth="1600" MaxHeight="1000" Stretch="Uniform" Visibility="Collapsed" />
                    <MediaPlayerElement x:Name="VideoView" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" Visibility="Collapsed" />
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#737B8C" FontSize="18" Text="No media loaded" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Controls intentionally occupy their own row and never cover the video. -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Slider x:Name="Timeline" Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged" />
                <Canvas x:Name="KeyframeCanvas" Margin="12,0" IsHitTestVisible="False" SizeChanged="KeyframeCanvas_SizeChanged" />
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="Previous_Click" ToolTipService.ToolTip="Previous item (Left)" Content="◀ Previous" />
                <Button Grid.Column="1" Click="StepBack_Click" ToolTipService.ToolTip="Previous frame (Comma)" Content="|◀ Frame" />
                <Button x:Name="PlayButton" Grid.Column="2" Click="Play_Click" ToolTipService.ToolTip="Play/pause (Space)" Content="▶ Play" />
                <Button Grid.Column="3" Click="StepForward_Click" ToolTipService.ToolTip="Next frame (Period)" Content="Frame ▶|" />
                <Button Grid.Column="4" Click="Next_Click" ToolTipService.ToolTip="Next item (Right)" Content="Next ▶" />
                <TextBlock x:Name="TimeText" Grid.Column="5" MinWidth="120" VerticalAlignment="Center" Text="00:00 / 00:00" />
                <TextBlock x:Name="StatusText" Grid.Column="6" VerticalAlignment="Center" Foreground="#AAB2C0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="Zoom" />
                <Slider x:Name="ZoomSlider" Grid.Column="8" Minimum="0.25" Maximum="8" StepFrequency="0.25" Value="1" ValueChanged="ZoomSlider_ValueChanged" />
                <TextBlock x:Name="ZoomText" Grid.Column="9" MinWidth="46" VerticalAlignment="Center" Text="100%" />
            </Grid>
        </Grid>
    </Grid>
</Page>
